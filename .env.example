# Copy to .env.local and fill in. Never commit real values.
# The same keys must be set in the Vercel project settings.

# Canonical origin — drives canonical URLs, OG tags, sitemap.xml and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email (contact form)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional — defaults to the address in src/lib/property.ts
CONTACT_INBOX=

# Direct bookings only (currently disabled)
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
YOCO_SECRET_KEY=
